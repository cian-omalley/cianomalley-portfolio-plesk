---
import { identity, districts } from '../data/site.js';
const { active = '' } = Astro.props;
// Primary nav uses the district map minus the arrival hub (that's the logo).
const links = districts.filter((d) => d.id !== 'arrival');
---
<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href="/" aria-label={`${identity.name} — home`}>
      <span class="nav__mark" aria-hidden="true"></span>
      <span class="nav__name">{identity.name}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class:list={["nav__link", { "is-active": active === l.id }]} title={l.label}>
          {l.short}
        </a>
      ))}
    </nav>

    <button class="nav__cmd" type="button" data-open-command aria-haspopup="dialog" aria-controls="command-menu">
      <span class="mono">Menu</span>
      <kbd class="nav__kbd">Esc</kbd>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-menu);
    background: linear-gradient(var(--bg-void), rgb(4 8 5 / 0.6) 70%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: var(--border-hair);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--white-soft);
    font-family: var(--font-display);
    font-weight: 600;
  }
  .nav__brand:hover { color: var(--white-soft); }
  .nav__mark {
    width: 14px; height: 14px;
    border-radius: 3px;
    background: var(--violet-electric);
    box-shadow: var(--glow-violet);
    transform: rotate(45deg);
  }
  .nav__name { font-size: 1rem; }
  .nav__links { display: none; gap: var(--space-5); }
  .nav__link {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.03em;
    color: var(--silver-moon);
    padding-block: var(--space-1);
    border-bottom: 1px solid transparent;
  }
  .nav__link:hover { color: var(--cyan-signal); }
  .nav__link.is-active { color: var(--white-soft); border-bottom-color: var(--violet-electric); }
  .nav__cmd {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: rgb(11 16 16 / 0.6);
    border: var(--border-hair);
    border-radius: var(--radius-control);
    color: var(--silver-moon);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    font-size: 0.8rem;
  }
  .nav__cmd:hover { border-color: var(--cyan-signal); color: var(--cyan-signal); }
  .nav__kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 1px 6px;
    border: var(--border-hair);
    border-radius: 4px;
    color: var(--text-muted);
  }
  @media (min-width: 900px) {
    .nav__links { display: flex; }
  }
</style>
