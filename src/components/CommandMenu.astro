---
// The radial "command control" from the concept (§1.5): an overlay dialog,
// reachable by button or the Esc key, listing every destination. DOM only —
// no WebGL. Keyboard + focus-trap handled in scripts/command-menu.js.
import { districts, identity } from '../data/site.js';
---
<div id="command-menu" class="cmd" role="dialog" aria-modal="true" aria-label="System menu" hidden>
  <div class="cmd__backdrop" data-close-command></div>
  <div class="cmd__panel panel" role="document">
    <div class="cmd__head">
      <p class="eyebrow">System menu</p>
      <button class="cmd__x" type="button" data-close-command aria-label="Close menu">✕</button>
    </div>
    <nav class="cmd__grid" aria-label="All destinations">
      {districts.map((d) => (
        <a class="cmd__item" href={d.href}>
          <span class="cmd__item-label">{d.label}</span>
          <span class="cmd__item-blurb">{d.blurb}</span>
        </a>
      ))}
    </nav>
    <div class="cmd__foot">
      {identity.social.map((s) => (
        <a class="cmd__social" href={s.href} rel="noopener">{s.label}</a>
      ))}
    </div>
  </div>
</div>

<style>
  .cmd {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: grid;
    place-items: center;
    padding: var(--space-4);
  }
  .cmd[hidden] { display: none; }
  .cmd__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(4 8 5 / 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: cmd-fade var(--dur-panel) var(--ease-out);
  }
  .cmd__panel {
    position: relative;
    width: min(100%, 720px);
    padding: var(--space-6);
    animation: cmd-rise var(--dur-panel) var(--ease-out);
  }
  .cmd__head { display: flex; align-items: center; justify-content: space-between; }
  .cmd__head .eyebrow { margin: 0; }
  .cmd__x {
    background: transparent; border: none; color: var(--silver-moon);
    font-size: 1.1rem; cursor: pointer; line-height: 1;
    padding: var(--space-2);
  }
  .cmd__x:hover { color: var(--cyan-signal); }
  .cmd__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  @media (min-width: 560px) { .cmd__grid { grid-template-columns: 1fr 1fr; } }
  .cmd__item {
    display: block;
    padding: var(--space-4);
    border: var(--border-hair);
    border-radius: var(--radius-control);
    background: rgb(11 16 16 / 0.5);
    transition: border-color var(--dur-micro) var(--ease-out),
                transform var(--dur-micro) var(--ease-out);
  }
  .cmd__item:hover { border-color: var(--violet-electric); transform: translateY(-2px); }
  .cmd__item-label { display: block; font-family: var(--font-display); color: var(--white-soft); }
  .cmd__item-blurb { display: block; font-size: 0.85rem; color: var(--text-muted); margin-top: 4px; }
  .cmd__foot {
    display: flex; flex-wrap: wrap; gap: var(--space-4);
    margin-top: var(--space-5); padding-top: var(--space-4);
    border-top: var(--border-hair);
    font-family: var(--font-mono); font-size: 0.8rem;
  }
  @keyframes cmd-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes cmd-rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .cmd__backdrop, .cmd__panel { animation: none; }
  }
</style>
