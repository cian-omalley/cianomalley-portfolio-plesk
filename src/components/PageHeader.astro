---
const { eyebrow, title, lede } = Astro.props;
---
<section class="phead">
  <div class="container">
    {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
    <h1 data-reveal>{title}</h1>
    {lede && <p class="lede" data-reveal>{lede}</p>}
  </div>
</section>

<style>
  .phead { padding-block: var(--space-9) var(--space-6); border-bottom: var(--border-hair); }
</style>
