---
import Base from '../layouts/Base.astro';
import Hero3D from '../components/Hero3D.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { districts, projects, identity } from '../data/site.js';

const featured = projects.filter((p) => p.featured);
const destinations = districts.filter((d) => d.id !== 'arrival');
---
<Base active="arrival">
  <Hero3D />

  <!-- Destinations map -->
  <section aria-labelledby="map-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Navigate the district</p>
        <h2 id="map-h" data-reveal>Eight destinations, one map</h2>
        <p class="lede" data-reveal>
          Every district maps to real content — nothing exists only in 3D. Jump straight in.
        </p>
      </div>
      <div class="grid grid--3 map">
        {destinations.map((d) => (
          <a class="map__cell panel" href={d.href} data-reveal>
            <span class="map__label">{d.label}</span>
            <span class="map__blurb">{d.blurb}</span>
            <span class="map__go mono" aria-hidden="true">enter →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured work -->
  <section aria-labelledby="work-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Best work first</p>
        <h2 id="work-h" data-reveal>Flagship projects</h2>
        <p class="lede" data-reveal>
          In-progress builds, entered with honest statuses. No invented results.
        </p>
      </div>
      <div class="grid grid--3">
        {featured.map((p) => <ProjectCard project={p} featured={true} />)}
      </div>
      <p class="more" data-reveal><a class="btn btn--ghost" href="/projects">All projects →</a></p>
    </div>
  </section>

  <!-- Contact strip -->
  <section aria-labelledby="relay-h">
    <div class="container">
      <div class="relay panel" data-reveal>
        <div>
          <p class="eyebrow">Communications Relay</p>
          <h2 id="relay-h">Building something, or want to talk shop?</h2>
          <p class="lede">
            {identity.name} is a {identity.role.toLowerCase()} based in {identity.location}.
          </p>
        </div>
        <a class="btn btn--primary" href="/contact">Open a channel</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .map__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    transition: transform var(--dur-panel) var(--ease-out),
                border-color var(--dur-panel) var(--ease-out);
  }
  .map__cell:hover { transform: translateY(-4px); border-color: rgb(124 58 237 / 0.5); }
  .map__label { font-family: var(--font-display); font-size: 1.15rem; color: var(--white-soft); }
  .map__blurb { color: var(--text-muted); font-size: 0.9rem; }
  .map__go { color: var(--cyan-signal); font-size: 0.78rem; margin-top: var(--space-2); }
  .more { margin-top: var(--space-6); }
  .relay {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-6); flex-wrap: wrap;
    padding: var(--space-7);
  }
  .relay h2 { margin-bottom: var(--space-2); }
  .relay .lede { margin: 0; }
</style>
