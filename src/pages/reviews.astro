---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { reviews } from '../data/site.js';
---
<Base active="reviews" title="Review Laboratory — Cian O'Malley" description="Hands-on reviews of IDEs and developer tools — Oxygen Builder 6, IntelliJ IDEA Ultimate, Antigravity, Codex.">
  <PageHeader
    eyebrow="Review Laboratory"
    title="Reviews"
    lede="Instrument benches for software and developer tools. Reviews are written from real use — not spec sheets."
  />

  <section aria-label="Reviews">
    <div class="container grid grid--2">
      {reviews.map((r) => (
        <article class="rcard panel" data-reveal>
          <div class="rcard__meta">
            <span class="chip">{r.category}</span>
            <span class="chip status status--progress">{r.verdict}</span>
          </div>
          <h3 class="rcard__title">{r.subject}</h3>
          <p class="rcard__excerpt">{r.excerpt}</p>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .rcard { padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3);
    transition: transform var(--dur-panel) var(--ease-out), border-color var(--dur-panel) var(--ease-out); }
  .rcard:hover { transform: translateY(-4px); border-color: rgb(34 211 238 / 0.4); }
  .rcard__meta { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .rcard__title { margin: 0; }
  .rcard__excerpt { color: var(--text-muted); margin: 0; font-size: 0.95rem; }
</style>
