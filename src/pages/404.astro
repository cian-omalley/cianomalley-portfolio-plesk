---
import Base from '../layouts/Base.astro';
---
<Base title="Signal lost — Cian O'Malley" description="This district doesn't exist.">
  <section class="nf">
    <div class="container nf__inner">
      <p class="eyebrow">Error 404</p>
      <h1>Signal lost</h1>
      <p class="lede">That district isn't on the map. The relay is still open, though.</p>
      <div class="nf__cta">
        <a class="btn btn--primary" href="/">Return to the Arrival Platform</a>
        <a class="btn btn--ghost" href="/projects">Project Sector</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 62svh; display: grid; place-items: center; text-align: center; }
  .nf__inner { max-width: 40rem; }
  .nf__cta { display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap; margin-top: var(--space-5); }
</style>
