---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/site.js';

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---
<Base active="projects" title="Project Sector — Cian O'Malley" description="Flagship developer projects and case studies — honest statuses, no invented results.">
  <PageHeader
    eyebrow="Project Sector"
    title="Projects"
    lede="Server-stack towers and case studies. Everything here is entered with an honest status — In Progress, Prototype, or Research."
  />

  <section aria-label="Featured projects">
    <div class="container">
      <h2 class="grouph" data-reveal>Flagship</h2>
      <div class="grid grid--3">
        {featured.map((p) => <ProjectCard project={p} featured={true} />)}
      </div>
    </div>
  </section>

  <section aria-label="More projects">
    <div class="container">
      <h2 class="grouph" data-reveal>Also in the works</h2>
      <div class="grid grid--3">
        {others.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .grouph { font-size: 1.1rem; color: var(--silver-moon); margin-bottom: var(--space-5); }
</style>
