---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { guides } from '../data/site.js';
---
<Base active="guides" title="Knowledge Archive — Cian O'Malley" description="Written guides on self-hosting, AI agents, WordPress, and developer tooling.">
  <PageHeader
    eyebrow="Knowledge Archive"
    title="Guides & articles"
    lede="A documentation shelf wall of written guides. The rule from the plan holds: every important video also exists as a written guide — and the writing ships first."
  />

  <section aria-label="Guides">
    <div class="container grid grid--2">
      {guides.map((g) => (
        <article class="gcard panel" data-reveal>
          <div class="gcard__meta">
            <span class="chip">{g.category}</span>
            <span class="chip status status--research">{g.status}</span>
          </div>
          <h3 class="gcard__title">{g.title}</h3>
          <p class="gcard__excerpt">{g.excerpt}</p>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .gcard { padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3);
    transition: transform var(--dur-panel) var(--ease-out), border-color var(--dur-panel) var(--ease-out); }
  .gcard:hover { transform: translateY(-4px); border-color: rgb(124 58 237 / 0.5); }
  .gcard__meta { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .gcard__title { margin: 0; }
  .gcard__excerpt { color: var(--text-muted); margin: 0; font-size: 0.95rem; }
</style>
